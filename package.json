{
  "name": "valoris-pretium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vercel": "^51.6.1",
    "vite": "^6.3.2",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.10.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:api": "tsx backend/dev-server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "vercel:login": "vercel env pull",
    "vercel:deploy:all:stage": "vercel deploy --target=staging",
    "vercel:deploy:all:prod": "vercel deploy --target=production",
    "deploy:cloudflare:worker": "wrangler deploy cloudflare/worker.ts",
    "deploy:firebase:web": "npm run build && firebase deploy --only hosting",
    "deploy:firebase:functions": "npm run build && firebase deploy --only functions",
    "tsc": "tsc --noemit",
    "vue:tsc": "npx vue-tsc --noemit",
    "npm:audit": "npm audit",
    "npm:audit:fix": "npm audit fix",
    "npm:install": "npm install"
  }
}
