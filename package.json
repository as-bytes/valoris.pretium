{
  "name": "valoris-pretium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx backend/dev-server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:vercel": "vercel deploy --prod",
    "deploy:cloudflare": "wrangler deploy cloudflare/worker.ts",
    "deploy:firebase": "npm run build && firebase deploy --only hosting,functions",
    "tsc": "tsc --noemit",
    "npm:audit": "npm audit",
    "npm:audit:fix": "npm audit fix",
    "npm:install": "npm install"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "wrangler": "^4.10.0"
  }
}
